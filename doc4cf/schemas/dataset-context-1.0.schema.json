{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doc4cf.org/schemas/dataset-context-1.0.schema.json",
  "title": "Doc4CF dataset context artifact",
  "type": "object",
  "required": ["context_version", "inventory_sha256", "dataset_profile", "conventions", "ambiguities", "needs_review"],
  "properties": {
    "context_version": {"const": "1.0"},
    "inventory_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dataset_profile": {"type": "string"},
    "conventions": {"type": "array", "items": {"$ref": "#/$defs/interpretation"}},
    "ambiguities": {"type": "array", "items": {"type": "string"}},
    "needs_review": {"type": "boolean"}
  },
  "$defs": {
    "interpretation": {
      "type": "object",
      "required": ["claim", "status", "evidence"],
      "properties": {
        "claim": {"type": "string"},
        "status": {"enum": ["verified", "inferred", "needs_review"]},
        "evidence": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
