    "feature::oslots": {
      "type": "edge_feature",
      "valid_on": [
        "otype::scroll",
        "otype::lex",
        "otype::fragment",
        "otype::line",
        "otype::clause",
        "otype::cluster",
        "otype::phrase",
        "otype::word"
      ],
      "featureName": "oslots",
      "description": "Maps each non-slot node to the slot nodes that make up its textual span. This core edge feature links structural units to the slots they cover and supports retrieving a node's text and relating it to the corpus's smallest units. Its edges express slot membership; they do not by themselves identify semantic, syntactic, or parent-child relationships between non-slot units.",
      "datatype": "String"
    },
    "feature::otext": {
      "type": "config_feature",
      "valid_on": [],
      "featureName": "otext",
      "description": "Configures Text-Fabric's Text API. Depending on the corpus, its settings can define section levels and their identifying features, text formats, and formatting templates. Text-Fabric uses this configuration to locate and render text for nodes. It is configuration rather than a node- or edge-valued feature, so its entries describe how the corpus is presented, not annotations attached to individual nodes.",
      "datatype": ""
    },
    "feature::otype": {
      "type": "node_feature",
      "valid_on": [
        "otype::scroll",
        "otype::lex",
        "otype::fragment",
        "otype::line",
        "otype::clause",
        "otype::cluster",
        "otype::phrase",
        "otype::word",
        "otype::sign"
      ],
      "featureName": "otype",
      "description": "Maps every Text-Fabric node to its node type. The type identifies what kind of structural unit the node represents, such as a slot or a larger unit defined by the corpus. This core node feature lets tools select nodes by type and interpret where other features apply. Type labels describe the corpus data model; their names alone do not establish the linguistic or semantic role of a unit.",
      "datatype": "String"
    },
